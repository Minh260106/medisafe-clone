# Example environment variables (do NOT store real secrets here)
# PostgreSQL format: postgresql://<username>:<password>@<host>:<port>/<database>
SQLALCHEMY_DATABASE_URL=postgresql://<username>:<password>@localhost:5432/medisafe_db

# Comma-separated list of origins allowed by CORS (e.g. local frontend dev servers)
CORS_ORIGINS=http://localhost:3000

# Secret Key cho JWT (BẮT BUỘC KHÔNG BỎ TRỐNG TRONG PRODUCTION)
SECRET_KEY=your_secure_random_secret_key_here
